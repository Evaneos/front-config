# Supply chain protection (ref INC-227)
# Refuse to install packages published in the last 7 days, leaving time for
# the community to detect and unpublish compromised versions.
min-release-age=7

# `min-release-age` requires npm >= 11.10.0; older versions only warn about the
# unknown directive and install without any cooldown. Paired with `engines.npm`
# in package.json, this aborts such an install with EBADENGINE before a single
# dependency is unpacked or its lifecycle scripts run.
engine-strict=true
